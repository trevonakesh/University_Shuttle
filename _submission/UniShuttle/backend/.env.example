# Copy this file to `.env` and fill in your own values.

# ---- Database ----
# Matches the credentials in docker-compose.yml
DATABASE_URL="postgresql://lankatrip_user:lankatrip_password@localhost:5432/lankatrip?schema=public"

DB_USER=lankatrip_user
DB_PASSWORD=lankatrip_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lankatrip

# ---- Auth ----
# Use a long random string in any real deployment.
JWT_SECRET=change_me_to_a_long_random_secret

PORT=3000

# ---- Admin seed account (optional) ----
# Used by seedAdmin.ts; defaults to admin@unishuttle.com / admin123
ADMIN_EMAIL=admin@unishuttle.com
ADMIN_PASSWORD=change_me

# ---- PayHere payment gateway (optional) ----
# Leave these commented out for local development: payments then complete
# instantly in-app instead of opening the card checkout.
#
# PUBLIC_URL must be reachable from the public internet, because PayHere's
# servers POST the payment confirmation to it. In development use a tunnel
# (e.g. cloudflared or ngrok); the URL changes each time the tunnel restarts.
#
# PAYHERE_MERCHANT_ID=your_merchant_id
# PAYHERE_MERCHANT_SECRET=your_merchant_secret
# PAYHERE_MODE=sandbox
# PUBLIC_URL=https://your-public-tunnel-url
# APP_PUBLIC_URL=http://localhost:3000
